              "schema": {
                "$ref": "#/components/schemas/SendInviteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation sent successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Send invitation to a user",
        "tags": [
          "auth"
        ]
      }
    },
